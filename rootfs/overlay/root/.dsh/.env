# Harness-home env file, read by dsh at startup.
#
# Why this is here: inside the app the guest's sockets are passed through to the
# host, but iOS refuses the host's outbound connects on some systems — the guest
# then gets EHOSTUNREACH for every non-loopback address, so no model request can
# leave. The app runs a loopback forwarder (DSHModelForwarder) that reaches the
# API through the host's own network, and this points dsh at it.
#
# It lives in $DSH_HOME/.env so that *every* form picks it up — `dsh web` (which
# the app supervises) and `dsh --profile tui` / `--profile headless` typed by
# hand in the terminal alike. The app also exports the same variable for the
# server it launches; an exported variable wins over this file, which is what we
# want.
#
# 31337 is the port DSHModelForwarder asks for first. If you change one, change
# both.
DEEPSEEK_BASE_URL=http://127.0.0.1:31337
