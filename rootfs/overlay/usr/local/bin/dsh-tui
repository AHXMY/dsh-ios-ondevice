#!/bin/sh
# dsh-tui -- the terminal front door of this app: it runs the `tui` profile.
#
# It runs dsh's interactive terminal surface. dsh itself ships no terminal app:
# the repository removed @deepseek-ai/dsh-tui on 2026-08-04 (see
# .agents/notes/implemented/simplification/2026-08-04-remove-tui-package.md), so
# `dsh` is now only a launcher and the terminal surface is an out-of-tree
# profile bundle. This image bakes in `@brianynwu/dsh-tui` ("Claude
# Code-style interactive terminal UI") as the `tui` profile.
#
# The difference from `--profile headless` matters: headless is the automation
# front door and prints only the final answer -- its runner drops text-delta and
# tool-call-delta on the floor, so no thinking stream and no tool cards. The TUI
# is a real client and renders both, and being one long-lived process it boots
# once instead of once per message.
#
# The terminal session this runs in is started by the app with nothing but TERM
# in its environment (see TerminalViewController.startSession), so this script
# has to establish PATH and HOME itself.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/root
DSH_HOME=${DSH_HOME:-/root/.dsh}
DSH_PKG=/usr/local/lib/node_modules/@deepseek-ai/dsh
DSH_BIN=$DSH_PKG/lib/bin.js
export PATH HOME DSH_HOME

: "${DSH_WORKSPACE:=/root/workspace}"
export DSH_WORKSPACE
mkdir -p "$DSH_WORKSPACE" 2>/dev/null || true

# The app leaves the host bridge URL and token here (a terminal session's
# environment carries nothing but TERM), which is what makes the iOS capability
# tools work from the terminal; it carries the forwarder URL with them.
#
# Read again before every harness round, not once at startup: the app can re-arm
# its forwarder on a different port after a suspension, and this file is the only
# channel by which the guest can learn that. One-shot reading is how a port
# change turns into a terminal that retries forever against a dead port --
# the app rewrote the file, and nothing in the guest ever looked again.
#
# iOS refuses the guest's own outbound connects, so the app runs that loopback
# forwarder on the host. dsh accepts the base URL only from the launching
# environment, never from a .env file, so it has to be exported here. The
# `dsh-tui` bundle reads it for the adapter's baseURL.
load_host_env() {
    if [ -r "$DSH_HOME/.host-bridge.env" ]; then
        set -a
        . "$DSH_HOME/.host-bridge.env"
        set +a
    fi
    : "${DEEPSEEK_BASE_URL:=http://127.0.0.1:31337}"
    export DEEPSEEK_BASE_URL
}
load_host_env

# dsh-base defaults to sandbox `workspace-write` plus approval `ask`, and
# neither half can work in this guest: the confining executors need bwrap or
# Landlock (the guest kernel has neither, and an unusable runner fails closed
# with SANDBOX_UNAVAILABLE rather than running unconfined), and approval is
# answered only by a UI channel or the ACP bridge -- as the repository notes,
# the TUI has no approval/request answerer either, so `ask` fails closed with
# nobody to ask. `danger-full-access` resolves the sandbox mode and, in the same
# expression, the approval policy to `never`.
: "${DSH_PERMISSION_MODE:=danger-full-access}"
export DSH_PERMISSION_MODE

# Session telemetry: off.
#
# dsh-base mounts `session-telemetry-otel` pointed at a DeepSeek-operated OTLP
# collector with mode FEEDBACK_ONLY: ordinary activity is never captured, but an
# explicit feedback action would release the session-log prefix (context
# included) tagged with the anonymous UUID in $DSH_HOME/.anonymous-user-id. This
# build ships no reporting channel, so the switch is set. The CLI turns any
# non-empty value into a hard disable patch for that row -- "a privacy switch
# prefers off-by-mistake over on-by-mistake" -- and the home-layer patch
# disables the same row again for anything that skips that path.
: "${DSH_TELEMETRY_DISABLED:=1}"
export DSH_TELEMETRY_DISABLED

# Install/refresh the agent presets the user dropped into the app's Documents.
#
# Nothing here comes from the network and nothing here is baked into the image:
# the private preset (persona + authorization registry + tools) is pushed over
# USB into the app's Documents folder, and iSH exposes that folder to the guest
# as a `real` mount (its path is in /proc/ish/documents; the same mechanism the
# iSH themes screen documents). The tarball is compared by sha256 against the
# installed marker, so this is a no-op unless the user actually pushed a new
# one. A missing file, an unmountable directory or a bad archive must never keep
# the terminal from starting, hence the `|| true` everywhere.
PRESET_DEST="$DSH_HOME/.agent-presets/security"
PRESET_MARK="$DSH_HOME/.agent-presets/.installed-sha"
HOST_DOCS_MNT=/mnt/host-documents

# busybox tar handles gzip itself, but the guest's applet set is not something
# this script should assume: fall back to piping gzip through plain tar.
unpack_preset() {
    tar xzf "$1" -C "$PRESET_DEST" 2>/dev/null && return 0
    gzip -dc "$1" 2>/dev/null | tar xf - -C "$PRESET_DEST" 2>/dev/null && return 0
    return 1
}

if [ -r /proc/ish/documents ]; then
    host_docs=$(cat /proc/ish/documents 2>/dev/null || true)
    if [ -n "$host_docs" ]; then
        mkdir -p "$HOST_DOCS_MNT" 2>/dev/null || true
        if mount -t real "$host_docs" "$HOST_DOCS_MNT" 2>/dev/null; then
            if [ -f "$HOST_DOCS_MNT/dsh-preset.tar.gz" ]; then
                want=$(cat "$HOST_DOCS_MNT/dsh-preset.sha256" 2>/dev/null | tr -d ' \r\n' || true)
                have=$(cat "$PRESET_MARK" 2>/dev/null | tr -d ' \r\n' || true)
                if [ -n "$want" ] && [ "$want" != "$have" ]; then
                    mkdir -p "$PRESET_DEST" 2>/dev/null || true
                    if unpack_preset "$HOST_DOCS_MNT/dsh-preset.tar.gz"; then
                        printf '%s\n' "$want" >"$PRESET_MARK" 2>/dev/null || true
                        printf '\033[1;32mpreset installed: %s (%s)\033[0m\n' "$PRESET_DEST" "$(printf '%s' "$want" | cut -c1-12)"
                        sleep 1
                    else
                        printf '\033[1;33mpreset archive could not be unpacked; keeping the previous one\033[0m\n'
                    fi
                fi
            fi
            # Session restore: a tarball of $DSH_HOME/sessions dropped in Documents
            # is unpacked before the harness starts. A reinstall (Sideloadly
            # uninstalls first, so iOS deletes the container) otherwise loses every
            # conversation, and AFC cannot bring them back -- it can overwrite
            # existing files but new ones never appear in iSH's metadata. This runs
            # inside the guest, so it can create them. Same shape as the preset:
            # applied only when the sha differs from the marker.
            if [ -f "$HOST_DOCS_MNT/dsh-sessions.tar.gz" ]; then
                swant=$(cat "$HOST_DOCS_MNT/dsh-sessions.sha256" 2>/dev/null | tr -d ' \r\n' || true)
                shave=$(cat "$DSH_HOME/.sessions-restored-sha" 2>/dev/null | tr -d ' \r\n' || true)
                if [ -n "$swant" ] && [ "$swant" != "$shave" ]; then
                    mkdir -p "$DSH_HOME/sessions" 2>/dev/null || true
                    if tar xzf "$HOST_DOCS_MNT/dsh-sessions.tar.gz" -C "$DSH_HOME/sessions" 2>/dev/null; then
                        printf '%s\n' "$swant" >"$DSH_HOME/.sessions-restored-sha" 2>/dev/null || true
                        printf '\033[1;32m已恢复历史会话（%s）\033[0m\n' "$(printf '%s' "$swant" | cut -c1-12)"
                        sleep 1
                    fi
                fi
            fi
            umount "$HOST_DOCS_MNT" 2>/dev/null || true
        fi
    fi
fi

# Say something before handing the screen to dsh. The terminal is already black
# when this script starts, and dsh takes a while to paint its first frame (node
# boots, ~250 plugin packages load, sessions are restored). Without this line the
# app looks dead for up to a minute on every cold start -- which is how it was
# reported: "black screen for a minute, then the home page appears".
# A banner instead of a bare line: this is the first thing on screen after the
# app's own splash, and it is what the user looks at while ~250 plugin packages
# load. No right-hand border anywhere -- CJK glyphs are double-width and a box
# that only lines up in a monospaced ASCII font would look broken here.
printf '\n'
printf '\033[1;36m  ██████╗ ███████╗██╗  ██╗\033[0m\n'
printf '\033[1;36m  ██╔══██╗██╔════╝██║  ██║\033[0m   \033[1;37mDeepSeek Harness\033[0m\n'
printf '\033[1;36m  ██║  ██║███████╗███████║\033[0m   \033[2m终端界面 · TUI\033[0m\n'
printf '\033[1;36m  ██║  ██║╚════██║██╔══██║\033[0m\n'
printf '\033[1;36m  ██████╔╝███████║██║  ██║\033[0m   \033[2m原版 dsh 本体 · @deepseek-ai/*\033[0m\n'
printf '\033[1;36m  ╚═════╝ ╚══════╝╚═╝  ╚═╝\033[0m   \033[2m终端渲染 · @brianynwu/dsh-tui\033[0m\n'
printf '\n'
printf '  \033[1;36m│\033[0m 模型  \033[1;37mdeepseek-flash\033[0m   推理  \033[1;37mmax\033[0m\n'
printf '  \033[1;36m│\033[0m 工作目录  \033[2m%s\033[0m\n' "$DSH_WORKSPACE"
printf '  \033[1;36m│\033[0m 权限预设  \033[1;33mdanger-full-access\033[0m\033[2m（无人应答审批，故全放行）\033[0m\n'
printf '  \033[1;36m╰\033[0m \033[2m正在加载插件，首次约 30~60 秒…（/preset 换预设，/model 换模型与档位）\033[0m\n'
printf '\n'

# A preset switch requested from inside the terminal.
#
# `/preset <id>` works in place only while the session is blank: the preset
# plugin fixes a session's composition at its first turn and answers anything
# later with `agent-preset/locked`. Its own TUI command therefore writes
# $DSH_HOME/.pending-preset instead of giving up, and this is the other half of
# that contract -- the request is honoured at the next start, as a NEW session
# under the chosen preset, because a new session reads its preset from the
# profile layer's `default:`.
PENDING_PRESET="$DSH_HOME/.pending-preset"
PROFILE_PATCH="$DSH_HOME/profiles/tui/cordis.patch.yml"

take_pending_preset() {
    [ -s "$PENDING_PRESET" ] || return 1
    want=$(head -n 1 "$PENDING_PRESET" 2>/dev/null | tr -d ' \r\n' || true)
    rm -f "$PENDING_PRESET" 2>/dev/null || true
    case "$want" in
        '' | *[!a-z0-9-]*)
            printf '\033[1;33m预设名不合法，已忽略：%s\033[0m\n' "$want"
            return 1
            ;;
    esac
    if [ -w "$PROFILE_PATCH" ] && grep -q '^ *default: ' "$PROFILE_PATCH" 2>/dev/null; then
        sed -i "s|^\( *\)default: .*|\1default: $want|" "$PROFILE_PATCH" 2>/dev/null || true
        printf '\033[1;32m默认预设已改为 %s：本次以新会话启动\033[0m\n' "$want"
    else
        printf '\033[1;33m找不到 profile 补丁，无法改默认预设；仍以新会话启动\033[0m\n'
    fi
    return 0
}

# The resolved composition, dumped boot-free.
#
# Whether the profile patch's rows actually landed is invisible from outside the
# process: a row that failed to load looks exactly like a row that was never
# written. `--dump-config` prints the tree the launcher WOULD boot (it starts no
# plugins), so this file is the answer, and it is readable over USB.
node --expose-internals "$DSH_BIN" --profile tui --dump-config >"$DSH_HOME/composition.log" 2>&1 || true

resume_arg=""
# Resume the most recent session by default.
#
# iOS reclaims this app once it has been in the background for a while (a Linux
# guest plus WebKit is a large footprint), so coming back to it usually means a
# cold start -- measured on the device as six launches in twenty-five minutes.
# Without this the TUI minted a brand-new session every time, which read as "the
# conversation is gone"; with it the terminal re-enters the session that was
# written last. An explicit argument (--resume=<id> or --help) still wins.
if [ "$#" -eq 0 ]; then
    if take_pending_preset; then
        # A preset was just chosen: it only takes effect on a session that has
        # not started, so resuming the previous one would defeat the request.
        resume_arg=""
    else
        newest=$(ls -1dt "$DSH_HOME"/sessions/*/main-session-* 2>/dev/null | head -n 1 || true)
        if [ -n "$newest" ]; then
            sid=$(basename "$newest")
            printf '  恢复上次会话 %s\n' "$sid"
            resume_arg="--resume=$sid"
        fi
    fi
fi

# Run the harness in a loop, in this same terminal session.
#
# The session ends when this script returns, and iSH answers a finished session by
# starting a new one -- which is exactly the reported symptom: the terminal shows
# the startup banner again and then a fresh `dsh >`, every few minutes, with no
# crash or memory report anywhere (the app never dies). Each round restarts the
# harness in place instead, and re-resolves the resume target so the conversation
# comes back with it. `@` still receives whatever arguments the caller passed.
# Model-path sampler.
#
# The harness reaches the model through the app's loopback forwarder. When that
# hop breaks, every request fails with TRANSPORT and the terminal reports
# "retrying model request" until the retry budget is gone -- no crash, no memory
# report, nothing in the session log except the failure.
#
# A transitions-only log could not answer the question that actually mattered:
# whether the hop breaks while the app is in the foreground. It recorded "up"
# once and one "down", and both readings were consistent with the app having
# been suspended in between. So this samples every cycle and writes every
# sample, and it makes a real HTTP request rather than a bare connect, because
# "the port accepts" and "the round trip returns" are different failures:
#
#   http 404   the whole path works (the upstream answers, so the proxy relayed)
#   err ECONNREFUSED   nothing is listening (or the refusal came back from the
#                      platform layer, which is what a torn-down socket looks
#                      like from inside the guest)
#   timeout / stuck    the connect or the request never completed -- the shape
#                      the terminal shows as a turn that hangs instead of dying
#
# `node` is guaranteed present (it is the harness runtime) and reports the exact
# error code. The port comes from the base URL the app handed this session, not
# a constant: if the app ever re-arms on a different port, a hardcoded probe
# would report a failure the harness does not have, or miss one it does.
#
# The file is trimmed every cycle, because this runs for the life of a session
# on a device nobody logs into.
declare_probe_port() {
    case "$DEEPSEEK_BASE_URL" in
        *:*) printf '%s' "${DEEPSEEK_BASE_URL##*:}" ;;
        *) printf '31337' ;;
    esac
}
probe_once() {
    DSH_PROBE_PORT="$1" node -e '
      const http = require("http");
      const port = Number(process.env.DSH_PROBE_PORT || 31337);
      let settled = false;
      const done = (line) => { if (!settled) { settled = true; console.log(line); process.exit(0); } };
      const req = http.request({ host: "127.0.0.1", port, path: "/", method: "GET", timeout: 4000 }, (res) => {
        res.resume();
        done("http " + res.statusCode);
      });
      req.on("timeout", () => { done("timeout"); req.destroy(); });
      req.on("error", (e) => { done("err " + (e.code || e.message)); });
      req.end();
      setTimeout(() => done("stuck"), 6000);
    ' 2>/dev/null
}
# One probe at a time: a heartbeat file older than 60s means the previous one died.
_hb="$DSH_HOME/.model-path-probe.hb"
_now=$(date +%s)
_prev=$(cat "$_hb" 2>/dev/null || echo 0)
if [ $((_now - _prev)) -ge 60 ]; then
    (
        port=$(declare_probe_port)
        printf '%s  sampler start  port=%s  base=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$port" "$DEEPSEEK_BASE_URL" >>"$DSH_HOME/model-path.log" 2>/dev/null || true
        while :; do
            date +%s >"$_hb" 2>/dev/null || true
            # Follow the app: a re-arm can move the port, and this file is where
            # that is announced.
            load_host_env
            port=$(declare_probe_port)
            now=$(probe_once "$port")
            [ -z "$now" ] && now="no-output"
            printf '%s  port=%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$port" "$now" >>"$DSH_HOME/model-path.log" 2>/dev/null || true
            # Keep the tail only: this loop runs for the life of the session.
            if [ -f "$DSH_HOME/model-path.log" ]; then
                tail -n 240 "$DSH_HOME/model-path.log" >"$DSH_HOME/model-path.log.tmp" 2>/dev/null &&
                    mv "$DSH_HOME/model-path.log.tmp" "$DSH_HOME/model-path.log" 2>/dev/null
            fi
            sleep 15
        done
    ) &
fi
printf '  模型通路探针已启动（日志 %s/model-path.log）\n' "$DSH_HOME"

round=0
while :; do
    round=$((round + 1))
    # A `/preset` typed during the previous round is honoured here, and only
    # here: the harness has just exited, so this is the one moment where a new
    # session can start under the requested preset.
    if take_pending_preset; then
        resume_arg=""
    fi
    # stderr is mirrored into a file: the TUI owns stdout/stdin for rendering, so
    # when it fails the reason lands on stderr, which no part of this app captures.
    load_host_env
    node --expose-internals "$DSH_BIN" --profile tui $resume_arg "$@" 2>"$DSH_HOME/tui.err"
    status=$?
    printf '\n\033[1;33mharness exited with %s\033[0m (round %s)\n' "$status" "$round"
    [ -s "$DSH_HOME/tui.err" ] && tail -n 5 "$DSH_HOME/tui.err"
    # Keep a durable record: the on-screen notice is replaced by the next round
    # within two seconds, so "it flashed and was gone" is all anyone can report.
    # This file is readable over USB afterwards, and it is the only evidence of a
    # clean exit that leaves no crash report anywhere.
    {
        printf '\n===== %s  exit=%s  round=%s =====\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$status" "$round"
        [ -s "$DSH_HOME/tui.err" ] && tail -n 12 "$DSH_HOME/tui.err"
    } >>"$DSH_HOME/tui-exits.log" 2>/dev/null || true
    printf 'restarting in 2s; Control-C stops it\n'
    newest=$(ls -1dt "$DSH_HOME"/sessions/*/main-session-* 2>/dev/null | head -n 1 || true)
    [ -n "$newest" ] && resume_arg="--resume=$(basename "$newest")"
    sleep 2
done
