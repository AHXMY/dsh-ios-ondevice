#!/bin/sh
# dsh-tui -- the terminal front door of this app: it runs the `tui` profile.
#
# It runs dsh's interactive terminal surface. dsh itself ships no terminal app:
# the repository removed @deepseek-ai/dsh-tui on 2026-08-04 (see
# .agents/notes/implemented/simplification/2026-08-04-remove-tui-package.md), so
# `dsh` is now only a launcher and the terminal surface is an out-of-tree
# profile bundle. This image bakes in `@brianynwu/dsh-tui` ("Claude
# Code-style interactive terminal UI") as the `tui` profile.
#
# The difference from `--profile headless` matters: headless is the automation
# front door and prints only the final answer -- its runner drops text-delta and
# tool-call-delta on the floor, so no thinking stream and no tool cards. The TUI
# is a real client and renders both, and being one long-lived process it boots
# once instead of once per message.
#
# The terminal session this runs in is started by the app with nothing but TERM
# in its environment (see TerminalViewController.startSession), so this script
# has to establish PATH and HOME itself.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/root
DSH_HOME=${DSH_HOME:-/root/.dsh}
DSH_PKG=/usr/local/lib/node_modules/@deepseek-ai/dsh
DSH_BIN=$DSH_PKG/lib/bin.js
export PATH HOME DSH_HOME

: "${DSH_WORKSPACE:=/root/workspace}"
export DSH_WORKSPACE
mkdir -p "$DSH_WORKSPACE" 2>/dev/null || true

# The app leaves the host bridge URL and token here (a terminal session's
# environment carries nothing but TERM), which is what makes the iOS capability
# tools work from the terminal; it carries the forwarder URL with them.
#
# Read again before every harness round, not once at startup: the app can re-arm
# its forwarder on a different port after a suspension, and this file is the only
# channel by which the guest can learn that. One-shot reading is how a port
# change turns into a terminal that retries forever against a dead port --
# the app rewrote the file, and nothing in the guest ever looked again.
#
# iOS refuses the guest's own outbound connects, so the app runs that loopback
# forwarder on the host. dsh accepts the base URL only from the launching
# environment, never from a .env file, so it has to be exported here. The
# `dsh-tui` bundle reads it for the adapter's baseURL.
load_host_env() {
    if [ -r "$DSH_HOME/.host-bridge.env" ]; then
        set -a
        . "$DSH_HOME/.host-bridge.env"
        set +a
    fi
    : "${DEEPSEEK_BASE_URL:=http://127.0.0.1:31337}"
    export DEEPSEEK_BASE_URL
}
load_host_env

# dsh-base defaults to sandbox `workspace-write` plus approval `ask`, and
# neither half can work in this guest: the confining executors need bwrap or
# Landlock (the guest kernel has neither, and an unusable runner fails closed
# with SANDBOX_UNAVAILABLE rather than running unconfined), and approval is
# answered only by a UI channel or the ACP bridge -- as the repository notes,
# the TUI has no approval/request answerer either, so `ask` fails closed with
# nobody to ask. `danger-full-access` resolves the sandbox mode and, in the same
# expression, the approval policy to `never`.
: "${DSH_PERMISSION_MODE:=danger-full-access}"
export DSH_PERMISSION_MODE

# Session telemetry: off.
#
# dsh-base mounts `session-telemetry-otel` pointed at a DeepSeek-operated OTLP
# collector with mode FEEDBACK_ONLY: ordinary activity is never captured, but an
# explicit feedback action would release the session-log prefix (context
# included) tagged with the anonymous UUID in $DSH_HOME/.anonymous-user-id. This
# build ships no reporting channel, so the switch is set. The CLI turns any
# non-empty value into a hard disable patch for that row -- "a privacy switch
# prefers off-by-mistake over on-by-mistake" -- and the home-layer patch
# disables the same row again for anything that skips that path.
: "${DSH_TELEMETRY_DISABLED:=1}"
export DSH_TELEMETRY_DISABLED

# Install/refresh the agent presets the user dropped into the app's Documents.
#
# Nothing here comes from the network and nothing here is baked into the image:
# the private preset (persona + authorization registry + tools) is pushed over
# USB into the app's Documents folder, and iSH exposes that folder to the guest
# as a `real` mount (its path is in /proc/ish/documents; the same mechanism the
# iSH themes screen documents). The tarball is compared by sha256 against the
# installed marker, so this is a no-op unless the user actually pushed a new
# one. A missing file, an unmountable directory or a bad archive must never keep
# the terminal from starting, hence the `|| true` everywhere.
PRESET_DEST="$DSH_HOME/.agent-presets/security"
PRESET_MARK="$DSH_HOME/.agent-presets/.installed-sha"
HOST_DOCS_MNT=/mnt/host-documents

# busybox tar handles gzip itself, but the guest's applet set is not something
# this script should assume: fall back to piping gzip through plain tar.
unpack_preset() {
    tar xzf "$1" -C "$PRESET_DEST" 2>/dev/null && return 0
    gzip -dc "$1" 2>/dev/null | tar xf - -C "$PRESET_DEST" 2>/dev/null && return 0
    return 1
}

if [ -r /proc/ish/documents ]; then
    host_docs=$(cat /proc/ish/documents 2>/dev/null || true)
    if [ -n "$host_docs" ]; then
        mkdir -p "$HOST_DOCS_MNT" 2>/dev/null || true
        if mount -t real "$host_docs" "$HOST_DOCS_MNT" 2>/dev/null; then
            if [ -f "$HOST_DOCS_MNT/dsh-preset.tar.gz" ]; then
                want=$(cat "$HOST_DOCS_MNT/dsh-preset.sha256" 2>/dev/null | tr -d ' \r\n' || true)
                have=$(cat "$PRESET_MARK" 2>/dev/null | tr -d ' \r\n' || true)
                if [ -n "$want" ] && [ "$want" != "$have" ]; then
                    mkdir -p "$PRESET_DEST" 2>/dev/null || true
                    if unpack_preset "$HOST_DOCS_MNT/dsh-preset.tar.gz"; then
                        printf '%s\n' "$want" >"$PRESET_MARK" 2>/dev/null || true
                        printf '\033[1;32mpreset installed: %s (%s)\033[0m\n' "$PRESET_DEST" "$(printf '%s' "$want" | cut -c1-12)"
                        sleep 1
                    else
                        printf '\033[1;33mpreset archive could not be unpacked; keeping the previous one\033[0m\n'
                    fi
                fi
            fi
            # The model credential travels the same way the preset does, and for
            # the same reason.
            #
            # It cannot be baked into the image (a secret does not belong in a
            # repository), and it cannot be written into the container before the
            # first launch either, because the guest's own paths do not exist
            # until the app has unpacked that image. Documents exists from the
            # moment the app is installed and the guest reads it through this
            # mount, so the key is staged there and applied here -- which is what
            # makes a fresh install usable on its FIRST launch instead of after
            # someone pushes files into a running container.
            if [ -f "$HOST_DOCS_MNT/dsh-key.env" ]; then
                if ! grep -q '^DEEPSEEK_API_KEY=.' "$DSH_HOME/.env" 2>/dev/null; then
                    if cp "$HOST_DOCS_MNT/dsh-key.env" "$DSH_HOME/.env" 2>/dev/null; then
                        printf '\033[1;32m已从 Documents 安装 API key\033[0m\n'
                        sleep 1
                    fi
                fi
            fi
            # Conversation restore: a tarball of $DSH_HOME/sessions dropped in
            # Documents is unpacked before the harness starts, because a
            # reinstall (Sideloadly uninstalls first, so iOS deletes the
            # container) otherwise loses every conversation, and AFC cannot bring
            # them back -- it can overwrite existing files but new ones never
            # appear in iSH's metadata. This runs inside the guest, so it can.
            #
            # It only ever runs into an EMPTY store, and that condition is the
            # whole safety of this block. The archive is a snapshot from the
            # moment it was packed; unpacking it over a live store replaces newer
            # conversations with older copies of themselves, and the marker file
            # cannot prevent that -- the marker lives in the container, so a
            # reinstall erases it and every later start looks like a first start.
            # Reported from the phone as "the last few messages are gone".
            if [ -f "$HOST_DOCS_MNT/dsh-sessions.tar.gz" ]; then
                swant=$(cat "$HOST_DOCS_MNT/dsh-sessions.sha256" 2>/dev/null | tr -d ' \r\n' || true)
                shave=$(cat "$DSH_HOME/.sessions-restored-sha" 2>/dev/null | tr -d ' \r\n' || true)
                live=$(ls -1d "$DSH_HOME"/sessions/*/main-session-* 2>/dev/null | wc -l | tr -d ' ')
                if [ -n "$swant" ] && [ "$swant" != "$shave" ] && [ "${live:-0}" -eq 0 ]; then
                    mkdir -p "$DSH_HOME/sessions" 2>/dev/null || true
                    if tar xzf "$HOST_DOCS_MNT/dsh-sessions.tar.gz" -C "$DSH_HOME/sessions" 2>/dev/null; then
                        # An archive packed from the parent directory carries one
                        # extra `sessions/` level, and unpacking it here would
                        # nest every conversation one directory too deep -- a
                        # restore that reports success and restores nothing.
                        # Accept both layouts rather than depend on which tar
                        # invocation produced the file.
                        if [ -d "$DSH_HOME/sessions/sessions" ]; then
                            for entry in "$DSH_HOME/sessions/sessions"/*; do
                                [ -e "$entry" ] || continue
                                mv "$entry" "$DSH_HOME/sessions/" 2>/dev/null || true
                            done
                            rmdir "$DSH_HOME/sessions/sessions" 2>/dev/null || true
                        fi
                        printf '%s\n' "$swant" >"$DSH_HOME/.sessions-restored-sha" 2>/dev/null || true
                        # A restored conversation is a conversation from another
                        # installation, and resuming one rebuilds the composition
                        # that produced it -- which is exactly what a session
                        # created before this deployment's profile patch carries:
                        # no model route at all. Auto-resuming such a session is
                        # how a fresh install turns into "has no provider/model"
                        # every single time. Start clean instead; the history is
                        # still there for the user to pick with /resume.
                        touch "$DSH_HOME/.sessions-just-restored" 2>/dev/null || true
                        count=$(ls -1d "$DSH_HOME"/sessions/*/main-session-* 2>/dev/null | wc -l | tr -d ' ')
                        printf '\033[1;32m已恢复历史会话 %s 个（%s）\033[0m\n' "$count" "$(printf '%s' "$swant" | cut -c1-12)"
                        sleep 1
                    fi
                fi
            fi
            umount "$HOST_DOCS_MNT" 2>/dev/null || true
        fi
    fi
fi

# Say something before handing the screen to dsh. The terminal is already black
# when this script starts, and dsh takes a while to paint its first frame (node
# boots, ~250 plugin packages load, sessions are restored). Without this line the
# app looks dead for up to a minute on every cold start -- which is how it was
# reported: "black screen for a minute, then the home page appears".
#
# A cold start gets the banner. A start within minutes of the last one is the
# harness being restarted (it does exit cleanly from time to time -- see
# tui-exits.log -- and the app answers a finished session with a fresh shell), so
# it gets one line: reprinting ten lines of ASCII art every few minutes reads as
# "this thing keeps restarting" rather than "it came back", which is how it was
# reported too.
_last_start="$DSH_HOME/.last-harness-start"
_now_epoch=$(date +%s)
_prev_start=$(cat "$_last_start" 2>/dev/null || echo 0)
_start_age=$((_now_epoch - _prev_start))
printf '%s\n' "$_now_epoch" >"$_last_start" 2>/dev/null || true
{
    printf '%s  launcher start  age=%ss\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$_start_age"
} >>"$DSH_HOME/launcher-starts.log" 2>/dev/null || true
# Keep the file bounded; it exists to show a restart cadence, not a history.
if [ -f "$DSH_HOME/launcher-starts.log" ]; then
    tail -n 120 "$DSH_HOME/launcher-starts.log" >"$DSH_HOME/.launcher-starts.tmp" 2>/dev/null &&
        mv "$DSH_HOME/.launcher-starts.tmp" "$DSH_HOME/launcher-starts.log" 2>/dev/null
fi

if [ "$_start_age" -lt 600 ] && [ "$_prev_start" -gt 0 ]; then
    printf '\n\033[1;33m  ⟳ 终端重新连接\033[0m\033[2m（%s 秒前启动过），正在恢复上次会话…\033[0m\n\n' "$_start_age"
else
    # One dim line, and no ASCII art.
    #
    # This used to be a ten-line banner, because the app handed the screen over
    # before the harness had anything to show and the wait needed filling. The
    # app now keeps its own launch screen up until the terminal UI takes the
    # screen over, so the banner has nothing left to cover and became a stage
    # the user has to sit through: reported as "why is there a middle step I
    # cannot interact with". The single line is only insurance for the case
    # where the launch screen comes down a moment before the first frame.
    printf '\033[2m  DSH 终端启动中…\033[0m\n'
fi

# A preset switch requested from inside the terminal.
#
# `/preset <id>` works in place only while the session is blank: the preset
# plugin fixes a session's composition at its first turn and answers anything
# later with `agent-preset/locked`. Its own TUI command therefore writes
# $DSH_HOME/.pending-preset instead of giving up, and this is the other half of
# that contract -- the request is honoured at the next start, as a NEW session
# under the chosen preset, because a new session reads its preset from the
# profile layer's `default:`.
PENDING_PRESET="$DSH_HOME/.pending-preset"
PROFILE_PATCH="$DSH_HOME/profiles/tui/cordis.patch.yml"

take_pending_preset() {
    [ -s "$PENDING_PRESET" ] || return 1
    want=$(head -n 1 "$PENDING_PRESET" 2>/dev/null | tr -d ' \r\n' || true)
    rm -f "$PENDING_PRESET" 2>/dev/null || true
    case "$want" in
        '' | *[!a-z0-9-]*)
            printf '\033[1;33m预设名不合法，已忽略：%s\033[0m\n' "$want"
            return 1
            ;;
    esac
    if [ -w "$PROFILE_PATCH" ] && grep -q '^ *default: ' "$PROFILE_PATCH" 2>/dev/null; then
        sed -i "s|^\( *\)default: .*|\1default: $want|" "$PROFILE_PATCH" 2>/dev/null || true
        printf '\033[1;32m默认预设已改为 %s：本次以新会话启动\033[0m\n' "$want"
    else
        printf '\033[1;33m找不到 profile 补丁，无法改默认预设；仍以新会话启动\033[0m\n'
    fi
    return 0
}

# The resolved composition, dumped boot-free.
#
# Whether the profile patch's rows actually landed is invisible from outside the
# process: a row that failed to load looks exactly like a row that was never
# written. `--dump-config` prints the tree the launcher WOULD boot (it starts no
# plugins), so this file is the answer, and it is readable over USB.
node --expose-internals "$DSH_BIN" --profile tui --dump-config >"$DSH_HOME/composition.log" 2>&1 || true

resume_arg=""
# Resume the most recent session by default.
#
# iOS reclaims this app once it has been in the background for a while (a Linux
# guest plus WebKit is a large footprint), so coming back to it usually means a
# cold start -- measured on the device as six launches in twenty-five minutes.
# Without this the TUI minted a brand-new session every time, which read as "the
# conversation is gone"; with it the terminal re-enters the session that was
# written last. An explicit argument (--resume=<id> or --help) still wins.
if [ "$#" -eq 0 ]; then
    if take_pending_preset; then
        # A preset was just chosen: it only takes effect on a session that has
        # not started, so resuming the previous one would defeat the request.
        resume_arg=""
    elif [ -f "$DSH_HOME/.new-session" ]; then
        # A new conversation was asked for from inside the terminal. The TUI's
        # /new writes this file, because a session cannot replace itself while it
        # is running -- the request is honoured here, at the next start.
        rm -f "$DSH_HOME/.new-session" 2>/dev/null || true
        printf '  新会话（历史会话：输入 /resume 选择）\n'
        resume_arg=""
    else
        # Otherwise put the conversation back.
        #
        # This is the point of the loop. The harness ends on its own every few
        # minutes on this platform -- always status 0, always an empty stderr, no
        # signal and no stdin event recorded inside the process, so the cause is
        # still open. What is certain is that an unexpected restart must not cost
        # the user their conversation: whichever session was open comes back. A
        # fresh one is asked for explicitly, with /new.
        newest=$(ls -1dt "$DSH_HOME"/sessions/*/main-session-* 2>/dev/null | head -n 1 || true)
        if [ -n "$newest" ]; then
            sid=$(basename "$newest")
            printf '  恢复会话 %s（要开新会话：/new）\n' "$sid"
            resume_arg="--resume=$sid"
        fi
    fi
fi

# Run the harness in a loop, in this same terminal session.
#
# The session ends when this script returns, and iSH answers a finished session by
# starting a new one -- which is exactly the reported symptom: the terminal shows
# the startup banner again and then a fresh `dsh >`, every few minutes, with no
# crash or memory report anywhere (the app never dies). Each round restarts the
# harness in place instead, and re-resolves the resume target so the conversation
# comes back with it. `@` still receives whatever arguments the caller passed.
# Model-path sampler.
#
# The harness reaches the model through the app's loopback forwarder. When that
# hop breaks, every request fails with TRANSPORT and the terminal reports
# "retrying model request" until the retry budget is gone -- no crash, no memory
# report, nothing in the session log except the failure.
#
# A transitions-only log could not answer the question that actually mattered:
# whether the hop breaks while the app is in the foreground. It recorded "up"
# once and one "down", and both readings were consistent with the app having
# been suspended in between. So this samples every cycle and writes every
# sample, and it makes a real HTTP request rather than a bare connect, because
# "the port accepts" and "the round trip returns" are different failures:
#
#   http 404   the whole path works (the upstream answers, so the proxy relayed)
#   err ECONNREFUSED   nothing is listening (or the refusal came back from the
#                      platform layer, which is what a torn-down socket looks
#                      like from inside the guest)
#   timeout / stuck    the connect or the request never completed -- the shape
#                      the terminal shows as a turn that hangs instead of dying
#
# `node` is guaranteed present (it is the harness runtime) and reports the exact
# error code. The port comes from the base URL the app handed this session, not
# a constant: if the app ever re-arms on a different port, a hardcoded probe
# would report a failure the harness does not have, or miss one it does.
#
# The file is trimmed every cycle, because this runs for the life of a session
# on a device nobody logs into.
declare_probe_port() {
    case "$DEEPSEEK_BASE_URL" in
        *:*) printf '%s' "${DEEPSEEK_BASE_URL##*:}" ;;
        *) printf '31337' ;;
    esac
}
probe_once() {
    DSH_PROBE_PORT="$1" node -e '
      const http = require("http");
      const port = Number(process.env.DSH_PROBE_PORT || 31337);
      let settled = false;
      const done = (line) => { if (!settled) { settled = true; console.log(line); process.exit(0); } };
      const req = http.request({ host: "127.0.0.1", port, path: "/", method: "GET", timeout: 4000 }, (res) => {
        res.resume();
        done("http " + res.statusCode);
      });
      req.on("timeout", () => { done("timeout"); req.destroy(); });
      req.on("error", (e) => { done("err " + (e.code || e.message)); });
      req.end();
      setTimeout(() => done("stuck"), 6000);
    ' 2>/dev/null
}
# One probe at a time: a heartbeat file older than 60s means the previous one died.
_hb="$DSH_HOME/.model-path-probe.hb"
_now=$(date +%s)
_prev=$(cat "$_hb" 2>/dev/null || echo 0)
if [ $((_now - _prev)) -ge 60 ]; then
    (
        port=$(declare_probe_port)
        printf '%s  sampler start  port=%s  base=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$port" "$DEEPSEEK_BASE_URL" >>"$DSH_HOME/model-path.log" 2>/dev/null || true
        while :; do
            date +%s >"$_hb" 2>/dev/null || true
            # Follow the app: a re-arm can move the port, and this file is where
            # that is announced.
            load_host_env
            port=$(declare_probe_port)
            now=$(probe_once "$port")
            [ -z "$now" ] && now="no-output"
            printf '%s  port=%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$port" "$now" >>"$DSH_HOME/model-path.log" 2>/dev/null || true
            # Keep the tail only: this loop runs for the life of the session.
            if [ -f "$DSH_HOME/model-path.log" ]; then
                tail -n 240 "$DSH_HOME/model-path.log" >"$DSH_HOME/model-path.log.tmp" 2>/dev/null &&
                    mv "$DSH_HOME/model-path.log.tmp" "$DSH_HOME/model-path.log" 2>/dev/null
            fi
            sleep 15
        done
    ) &
fi
printf '  模型通路探针在跑（日志 %s/model-path.log）\n' "$DSH_HOME" >/dev/null 2>&1 || true

# The instrument that names the cause of a clean exit.
#
# Written here rather than shipped in the image so it can be changed without a
# rebuild: the harness has been exiting with status 0 and an empty stderr on a
# few-minute cadence, `--trace-exit` printed nothing (so nothing calls exit), and
# that leaves exactly one candidate -- the event loop draining because stdin
# ended. This records the order of events so the next occurrence says which
# happened: a signal, stdin ending, or the loop emptying on its own.
cat >"$DSH_HOME/node-events.cjs" <<'DSH_NODE_EVENTS'
// Records what ends the harness's process, and what memory looked like first.
//
// Loaded with `node --require`, so it runs inside the process that dies. Two
// questions, one file:
//
//   1. How does it end? Every catchable signal, stdin ending, the event loop
//      draining and the exit callback are all recorded. On the occurrence this
//      file was written for, NONE of them fired -- which is what SIGKILL looks
//      like, and the only signal in that set a process cannot observe.
//
//   2. How much memory was there? RSS of this process plus the guest's own
//      MemAvailable, sampled on a timer. The guest is a memory-capped virtual
//      machine, the harness is the largest thing inside it, and the interval
//      between deaths (five to six minutes) is the shape of memory filling up
//      rather than of anything on a clock -- so the last few samples before a
//      death either show the wall arriving or rule it out.
const fs = require('fs');
const path = require('path');
const home = process.env.DSH_HOME || '/root/.dsh';
const events = path.join(home, 'node-events.log');
const memory = path.join(home, 'node-memory.log');
const started = Date.now();
const mb = (bytes) => (bytes / 1048576).toFixed(1);

// A body that runs inside the harness. Its one job is to be the only witness to
// how the process ends, so a write that fails has to say so: a swallowed error
// here turns "the log is empty" into "nothing happened", which is exactly the
// mistake this probe exists to avoid.
const warned = new Set();
const say = (file, message) => {
    try {
        fs.appendFileSync(file, new Date().toISOString() + '  +' +
            ((Date.now() - started) / 1000).toFixed(1) + 's  ' + message + '\n');
    } catch (error) {
        const key = file + ':' + (error && error.code);
        if (!warned.has(key)) {
            warned.add(key);
            try {
                process.stderr.write('probe: cannot write ' + file + ' (' +
                    ((error && error.code) || error) + ')\n');
            } catch {}
        }
    }
};

const guestAvailableMb = () => {
    try {
        const info = fs.readFileSync('/proc/meminfo', 'utf8');
        const available = /MemAvailable:\s+(\d+) kB/.exec(info);
        const total = /MemTotal:\s+(\d+) kB/.exec(info);
        return (available ? (available[1] / 1024).toFixed(0) : '?') + '/' +
               (total ? (total[1] / 1024).toFixed(0) : '?');
    } catch {
        return 'unreadable';
    }
};

say(events, 'start pid=' + process.pid + ' script=' + process.argv[1]);
process.on('exit', (code) => say(events, 'exit code=' + code));
process.on('beforeExit', (code) => say(events, 'beforeExit code=' + code + ' (event loop drained)'));
['SIGHUP', 'SIGINT', 'SIGTERM', 'SIGQUIT', 'SIGWINCH', 'SIGTSTP', 'SIGCONT'].forEach((signal) => {
    process.on(signal, () => say(events, 'signal ' + signal));
});
for (const name of ['stdin', 'stdout', 'stderr']) {
    const stream = process[name];
    if (!stream) continue;
    stream.on('end', () => say(events, name + ' end'));
    stream.on('close', () => say(events, name + ' close'));
    stream.on('error', (error) => say(events, name + ' error ' + (error && error.code)));
}
if (process.stdin && process.stdin.isTTY) {
    say(events, 'stdin is a tty');
    process.stdout.on('resize', () =>
        say(events, 'resize ' + process.stdout.columns + 'x' + process.stdout.rows));
}

// Heap ceiling: the OOM hypothesis says the guest's kernel kills this process
// because it is the biggest thing in a capped virtual machine. Capping V8's old
// space makes it collect instead of growing into the wall, which turns a kill
// into a slow-down -- and if the deaths stop, that is the answer.
if (!process.env.DSH_NO_HEAP_CAP) {
    try {
        const v8 = require('v8');
        const configured = v8.getHeapStatistics().heap_size_limit / 1048576;
        say(events, 'heap limit ' + configured.toFixed(0) + ' MB at start');
    } catch {}
}

// Several ways to ask for the process's real footprint.
//
// `process.memoryUsage().rss` came back 0 on this platform, and the guest's
// /proc/meminfo is not trustworthy either (it reported 3786 MB free with nothing
// used), so the only way to tell whether a memory wall is involved is to try
// every source and keep whatever answers. A kill by the kernel's out-of-memory
// killer leaves no trace in the process, so the number has to come from outside
// the heap: RSS, which includes the 250 packages' code and every buffer.
const readRssMb = () => {
    const sources = [];
    try {
        const status = fs.readFileSync('/proc/self/status', 'utf8');
        const m = /VmRSS:\s+(\d+) kB/.exec(status);
        if (m) sources.push((m[1] / 1024).toFixed(0) + 'MB(status)');
    } catch {}
    try {
        const statm = fs.readFileSync('/proc/self/statm', 'utf8').trim().split(/\s+/);
        if (statm.length > 1) sources.push((Number(statm[1]) * 4096 / 1048576).toFixed(0) + 'MB(statm)');
    } catch {}
    const self = process.memoryUsage().rss / 1048576;
    if (self > 0) sources.push(self.toFixed(0) + 'MB(hint)');
    return sources.length ? sources.join(' ') : 'unreadable';
};

let ticks = 0;
const timer = setInterval(() => {
    const usage = process.memoryUsage();
    say(memory, 'rss=' + readRssMb() + ' heapUsed=' + mb(usage.heapUsed) + 'MB heapTotal=' + mb(usage.heapTotal) + 'MB guest=' + guestAvailableMb() + 'MB');
    ticks += 1;
    if (ticks === 1) say(events, 'memory sampling started');
}, 10000);
timer.unref();
DSH_NODE_EVENTS
# Memory and kernel messages, sampled.
#
# The probe that runs inside the harness records stdin ending, beforeExit, exit
# and the catchable signals -- and on the occurrence it witnessed, NONE of them
# fired. A process that dies without any of those was killed with a signal it
# cannot catch, and on this emulator the prime suspect is the guest's own
# out-of-memory killer: the harness is the largest thing in a memory-capped
# virtual machine, and the interval (five to six minutes) is the shape of memory
# filling up rather than of anything on a timer. Both halves of that claim are
# cheap to record, so record them: what memory looked like, and what the kernel
# said about killing something.
(
    while :; do
        {
            printf '%s  ' "$(date '+%Y-%m-%d %H:%M:%S')"
            free -m 2>/dev/null | tr '\n' ' ' || true
            printf '\n'
        } >>"$DSH_HOME/memory.log" 2>/dev/null || true
        if [ -f "$DSH_HOME/memory.log" ]; then
            tail -n 240 "$DSH_HOME/memory.log" >"$DSH_HOME/.memory.tmp" 2>/dev/null &&
                mv "$DSH_HOME/.memory.tmp" "$DSH_HOME/memory.log" 2>/dev/null
        fi
        dmesg 2>/dev/null | tail -n 4 >>"$DSH_HOME/kernel.log" 2>/dev/null || true
        if [ -f "$DSH_HOME/kernel.log" ]; then
            tail -n 200 "$DSH_HOME/kernel.log" >"$DSH_HOME/.kernel.tmp" 2>/dev/null &&
                mv "$DSH_HOME/.kernel.tmp" "$DSH_HOME/kernel.log" 2>/dev/null
        fi
        sleep 10
    done
) &

# Probe self-test, run once per session.
#
# The harness keeps ending with status 0 while the callbacks installed inside it
# never record a thing, and those two facts cannot both be true of the same
# process -- unless the recording itself is what fails. This exits a throwaway
# node process explicitly and reports whether its own exit callback managed to
# write, which separates "nothing fired" from "the log quietly went nowhere".
if [ ! -f "$DSH_HOME/probe-selftest.log" ] || [ "$(wc -l <"$DSH_HOME/probe-selftest.log" 2>/dev/null | tr -d ' ')" = "0" ]; then
    node -e '
      const fs = require("fs");
      const target = process.env.DSH_HOME + "/probe-selftest.log";
      const write = (line) => {
        try { fs.appendFileSync(target, line + "\n"); }
        catch (error) { console.error("selftest write failed: " + (error && error.code)); }
      };
      process.on("beforeExit", () => write("beforeExit fired"));
      process.on("exit", (code) => write("exit fired code=" + code));
      process.exit(7);
    ' 2>>"$DSH_HOME/tui.err" || true
fi
printf '  探针自检: %s\n' "$(tr '\n' ' ' <"$DSH_HOME/probe-selftest.log" 2>/dev/null || echo '（无记录）')"

# Guest heartbeat, once per second, running for the life of the shell.
#
# It exists to answer one question that nothing else can: was the emulator itself
# stopped? A process that is killed leaves no gap in a heartbeat; an emulator that
# is suspended and restored does. If this file has a hole at the same moment node
# disappears, then nothing "killed node" -- the whole guest stopped and the
# processes that came back are the ones that survive a save/restore.
(
    while :; do
        printf '%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" >>"$DSH_HOME/heartbeat.log"
        if [ -f "$DSH_HOME/heartbeat.log" ]; then
            tail -n 2000 "$DSH_HOME/heartbeat.log" >"$DSH_HOME/.hb.tmp" 2>/dev/null &&
                mv "$DSH_HOME/.hb.tmp" "$DSH_HOME/heartbeat.log" 2>/dev/null
        fi
        sleep 1
    done
) &

# --- one harness at a time --------------------------------------------------
#
# The app opens a new terminal session every time it comes back, and nothing ever
# stopped the previous one: each session started its own instance of this script,
# and each of those kept its own harness alive. Measured on device: twenty node
# processes at once, in two size classes (716 MB and 800 MB resident), i.e. at
# least two complete dsh installs -- a harness is ~250 plugin packages.
#
# The pile-up is what kills the app. iOS kills the app once its memory crosses the
# line; the guest comes back from a fork-based image restore, and a fork only
# carries the calling thread, so every multi-threaded process (node, and nothing
# else in this guest) is gone when it resumes. From the user's side that is the
# terminal restarting for no reason, several times an hour.
#
# So: a new session takes the terminal from any earlier one. Its shell, its
# harness, its watchers and its samplers all go first, including the orphaned
# harnesses of sessions that died earlier (they are reparented to init, which is
# why they were never cleaned up).
LOCK="$DSH_HOME/dsh-tui.lock"
children_of() {
    ps -o pid,ppid 2>/dev/null | awk -v p="$1" '$2 == p { print $1 }'
}
kill_tree() {
    for c in $(children_of "$1"); do
        kill_tree "$c"
        kill -9 "$c" 2>/dev/null || true
    done
}
if [ -f "$LOCK" ]; then
    old=$(cat "$LOCK" 2>/dev/null)
    if [ -n "$old" ] && [ "$old" != "$$" ] && kill -0 "$old" 2>/dev/null; then
        printf '%s  taking over from session pid=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$old" >>"$DSH_HOME/takeover.log"
        kill_tree "$old"
        kill -9 "$old" 2>/dev/null || true
    fi
fi
# Orphans from sessions that were killed outright: harnesses, this script, the
# samplers. init is their parent now, so nothing else is going to reap them.
for pid in $(ps -o pid,ppid,args 2>/dev/null | awk '$2 == 1 && (/bin\.js/ || /dsh-tui/ || /[n]ode/) { print $1 }'); do
    [ "$pid" = "$$" ] && continue
    printf '%s  reaping orphan pid=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$pid" >>"$DSH_HOME/takeover.log"
    kill -9 "$pid" 2>/dev/null || true
done
printf '%s' "$$" >"$LOCK"

round=0
while :; do
    round=$((round + 1))
    # A `/preset` typed during the previous round is honoured here, and only
    # here: the harness has just exited, so this is the one moment where a new
    # session can start under the requested preset.
    if take_pending_preset; then
        resume_arg=""
    fi
    # stderr is mirrored into a file: the TUI owns stdout/stdin for rendering, so
    # when it fails the reason lands on stderr, which no part of this app captures.
    load_host_env
    # Something on screen for the whole reload, and something a user can act on.
    #
    # Between rounds this process owns the terminal for 20-40 seconds while the
    # harness loads ~250 plugin packages, and the previous round left the screen
    # blank (the TUI works on the alternate screen, which it clears on exit). To
    # a user that is a black screen with no keyboard response, which reads as a
    # hang. Naming what is happening, and why typing does nothing yet, is the
    # whole fix available from inside the guest.
    if [ "$round" -gt 1 ]; then
        printf '\n\033[1;33m终端已重启（第 %s 轮）\033[0m\n' "$round"
        printf '  上一轮自己退出了（exit=%s，见 %s/tui-exits.log）\n' "$status" "$DSH_HOME"
    fi
    printf '  \033[2m正在加载 harness，约 20~40 秒；这段时间键盘没有反应是正常的…\033[0m\n'
    # `--trace-exit` makes a deliberate exit print the stack that called it.
    #
    # Nothing was printed, which is itself the finding: the harness is not calling
    # process.exit(), it is ending because its event loop empties -- i.e. its
    # standard input reaches EOF. That points at the app-side session being
    # rebuilt, not at anything inside the harness. The preload below records the
    # order of events (beforeExit, stdin end/close, signals) so the next exit has
    # a cause attached instead of a theory.
    # Diagnostic twin: a plain node process, no terminal attached, started
    # alongside the harness.
    #
    # The question it answers is whether the killer is inside the harness or
    # outside it. This process cannot leak, cannot exit on its own, and has no tty
    # to lose, so if it dies at the same cadence then whatever kills the harness
    # kills everything in the guest; if it outlives the harness, the harness is
    # the target specifically.
    (
        # Its own process group, so a kill aimed at the foreground group takes the
        # harness and leaves this one alone.
        #
        # An empty LD_PRELOAD is what suppresses the kernel's injection: exec.c
        # adds /lib/zero_free.so only when the program is named `node` AND no
        # LD_PRELOAD is already in the environment. So this twin runs without the
        # library, and the one below runs with it. Everything else about them is
        # identical, which is what makes them a comparison rather than two more
        # processes that died.
        if command -v setsid >/dev/null 2>&1; then
            setsid env LD_PRELOAD= node -e 'const fs = require("fs"); const p = process.env.DSH_HOME + "/twin.log"; fs.appendFileSync(p, new Date().toISOString() + "  twin start node pid=" + process.pid + "\n"); fs.writeFileSync(process.env.DSH_HOME + "/.witness-no.pid", String(process.pid)); process.on("exit", (c) => fs.appendFileSync(p, new Date().toISOString() + "  twin exit code=" + c + "\n")); setInterval(() => {}, 3600000);' >/dev/null 2>&1
        else
            LD_PRELOAD= node -e 'const fs = require("fs"); const p = process.env.DSH_HOME + "/twin.log"; fs.appendFileSync(p, new Date().toISOString() + "  twin start node pid=" + process.pid + "\n"); fs.writeFileSync(process.env.DSH_HOME + "/.witness-no.pid", String(process.pid)); process.on("exit", (c) => fs.appendFileSync(p, new Date().toISOString() + "  twin exit code=" + c + "\n")); setInterval(() => {}, 3600000);' >/dev/null 2>&1
        fi
    ) &
    (
        # The same thing WITH /lib/zero_free.so, the library the kernel injects
        # into anything named `node`. If this one dies while the other lives, that
        # library is what has been killing the harness.
        if command -v setsid >/dev/null 2>&1; then
            setsid env LD_PRELOAD=/lib/zero_free.so node -e 'const fs = require("fs"); const p = process.env.DSH_HOME + "/twin.log"; fs.appendFileSync(p, new Date().toISOString() + "  twin-preload start node pid=" + process.pid + "\n"); fs.writeFileSync(process.env.DSH_HOME + "/.witness-pre.pid", String(process.pid)); process.on("exit", (c) => fs.appendFileSync(p, new Date().toISOString() + "  twin-preload exit code=" + c + "\n")); setInterval(() => {}, 3600000);' >/dev/null 2>&1
        fi
    ) &
    # Second-grain record of every node process in the guest.
    #
    # The per-round check only says a witness was already gone by the time the
    # harness ended, which leaves minutes of slack and cannot tell one death from
    # two. This samples by name instead, so it covers the harness as well as the
    # witnesses, and it records the vitals that would explain a death: process
    # state, thread count and resident size. A process the kernel reaped for
    # memory, or one that is sitting in D state first, looks different here from
    # one that was shot.
    (
        while :; do
            for pid in $(ps 2>/dev/null | awk '/[n]ode/ {print $1}'); do
                state=$(sed -n 's/^State:[[:space:]]*\([A-Z]\).*/\1/p' "/proc/$pid/status" 2>/dev/null)
                threads=$(sed -n 's/^Threads:[[:space:]]*\([0-9]*\).*/\1/p' "/proc/$pid/status" 2>/dev/null)
                rss=$(awk '{print int($2 * 4096 / 1048576)}' "/proc/$pid/statm" 2>/dev/null)
                printf '%s  node pid=%s state=%s threads=%s rssMB=%s\n' \
                    "$(date '+%Y-%m-%d %H:%M:%S')" "$pid" "${state:-?}" "${threads:-?}" "${rss:-?}" >>"$DSH_HOME/watch.log"
            done
            if [ -f "$DSH_HOME/watch.log" ]; then
                tail -n 400 "$DSH_HOME/watch.log" >"$DSH_HOME/.watch.tmp" 2>/dev/null &&
                    mv "$DSH_HOME/.watch.tmp" "$DSH_HOME/watch.log" 2>/dev/null
            fi
            sleep 2
        done
    ) & watcher=$!
    printf '%s  witnesses: launcher=%s harness_start=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$$" "$(date '+%s')" >>"$DSH_HOME/twin.log"
    node --trace-exit --require "$DSH_HOME/node-events.cjs" --expose-internals "$DSH_BIN" --profile tui $resume_arg "$@" 2>"$DSH_HOME/tui.err"
    status=$?

    # Reap orphans between rounds as well, not just at startup.
    #
    # A harness started by a session that then died is reparented to init and left
    # there: nothing in this guest reaps it, and each one is a full dsh install
    # (hundreds of plugin packages) that iOS will count against this app. Killing
    # them here keeps the invariant true while the app is running, not only at the
    # moment a new session takes over.
    for pid in $(ps -o pid,ppid,args 2>/dev/null | awk '$2 == 1 && (/bin\.js/ || /dsh-tui/ || /[n]ode/) { print $1 }'); do
        [ "$pid" = "$$" ] && continue
        printf '%s  round %s: reaping orphan pid=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$round" "$pid" >>"$DSH_HOME/takeover.log"
        kill -9 "$pid" 2>/dev/null || true
    done

    # Round-level verdict on the witnesses. They are deliberately NOT killed here:
    # whether a node process outlives the harness is the whole question, and a
    # cleanup that runs at the same instant the harness dies would answer it
    # wrongly. The watcher above keeps sampling them by name.
    for pair in "no:.witness-no.pid" "pre:.witness-pre.pid"; do
        label=${pair%%:*}
        pidfile=${pair#*:}
        pid=$(cat "$DSH_HOME/$pidfile" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            printf '%s  round %s: %s pid=%s STILL ALIVE when the harness died\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$round" "$label" "$pid" >>"$DSH_HOME/twin.log"
        else
            printf '%s  round %s: %s pid=%s gone\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$round" "$label" "$pid" >>"$DSH_HOME/twin.log"
        fi
    done
    rm -f "$DSH_HOME/.witness-no.pid" "$DSH_HOME/.witness-pre.pid"
    kill "$watcher" 2>/dev/null

    # Post-mortem: the kernel's version and the process table at the moment of
    # death. Nothing inside the harness runs at that moment, so the cause has to
    # be recorded from outside it -- and until now nothing was.
    {
        printf '\n===== %s  round=%s  exit=%s  guest_uptime=%s =====\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$round" "$status" "$(cut -d' ' -f1 /proc/uptime 2>/dev/null)"
        printf -- '--- dmesg ---\n'
        dmesg 2>&1 | tail -n 30
        printf -- '--- ps (pid,ppid,pgid,sid,args) ---\n'
        ps -o pid,ppid,pgid,sid,args 2>/dev/null || ps 2>&1 | tail -n 20
        printf -- '--- node processes left ---\n'
        ps 2>/dev/null | grep -c '[n]ode' || true
        printf -- '--- free ---\n'
        free -m 2>&1 | head -n 3
        printf -- '--- tty size ---\n'
        stty size 2>&1
        printf -- '--- last events recorded inside the harness ---\n'
        tail -n 4 "$DSH_HOME/node-events.log" 2>/dev/null
    } >>"$DSH_HOME/postmortem.log" 2>&1 || true
    if [ -f "$DSH_HOME/postmortem.log" ]; then
        tail -n 400 "$DSH_HOME/postmortem.log" >"$DSH_HOME/.pm.tmp" 2>/dev/null &&
            mv "$DSH_HOME/.pm.tmp" "$DSH_HOME/postmortem.log" 2>/dev/null
    fi

    printf '\n\033[1;33m终端已重启（第 %s 轮）\033[0m\n' "$((round + 1))"
    [ -s "$DSH_HOME/tui.err" ] && tail -n 5 "$DSH_HOME/tui.err"
    # Keep a durable record: the on-screen notice is replaced by the next round
    # within two seconds, so "it flashed and was gone" is all anyone can report.
    # This file is readable over USB afterwards, and it is the only evidence of a
    # clean exit that leaves no crash report anywhere.
    {
        printf '\n===== %s  exit=%s  round=%s =====\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$status" "$round"
        [ -s "$DSH_HOME/tui.err" ] && tail -n 12 "$DSH_HOME/tui.err"
    } >>"$DSH_HOME/tui-exits.log" 2>/dev/null || true
    # A restart is a new conversation, the same as /quit is.
    #
    # This used to re-resolve the newest session before every round, which is
    # what made /quit feel like it did nothing: the harness came back up inside
    # the conversation you had just left. The pause stays short -- every second
    # here is a second of a terminal that cannot be typed into.
    sleep 1
done
