#!/bin/sh
# dsh-cli -- an interactive front door to the harness, built only from the
# official package that already ships in this image.
#
# dsh publishes no terminal UI. What it does publish is `--profile headless`:
# answer one task, print the answer, exit. Every released version creates a
# *fresh* session per run -- `sessionId: brand-string("session-" + randomUUID())`
# is hard-wired in @deepseek-ai/dsh-headless, and there is no `--resume` option
# in 0.1.0-rc.7, 0.1.2-rc.1, 0.1.3-alpha.2 or 0.1.5-rc.2 (checked by unpacking
# each from npm; only the unreleased tree has it).
#
# So continuity is carried here instead: each turn hands the model the
# conversation so far along with the new line. That is a transcript, not a live
# session -- tool activity from earlier turns is not replayed, and every turn
# re-sends the history. `/context off` gives the plain official one-shot form;
# `/new` starts over.
#
# The terminal session this runs in is started by the app with nothing but TERM
# in its environment (see TerminalViewController.startSession), so this script
# has to establish PATH and HOME itself.

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/root
DSH_HOME=${DSH_HOME:-/root/.dsh}
WORKSPACE=${DSH_WORKSPACE:-/root/workspace}
DSH_PKG=/usr/local/lib/node_modules/@deepseek-ai/dsh
DSH_BIN=$DSH_PKG/lib/bin.js
TRANSCRIPT=$DSH_HOME/.cli-transcript
MAX_TRANSCRIPT=12000
export PATH HOME DSH_HOME

# The app leaves the host bridge URL and token here (a terminal session's
# environment carries nothing but TERM), which is what makes the iOS capability
# tools work from this CLI; it carries the forwarder URL with them.
if [ -r "$DSH_HOME/.host-bridge.env" ]; then
	set -a
	. "$DSH_HOME/.host-bridge.env"
	set +a
fi

# iOS refuses the guest's own outbound connects, so the app runs a loopback
# forwarder on the host. dsh accepts the base URL only from the launching
# environment, never from a .env file, so it has to be exported here.
: "${DEEPSEEK_BASE_URL:=http://127.0.0.1:31337}"
export DEEPSEEK_BASE_URL

# dsh-base defaults to sandbox `workspace-write` plus approval `ask`, and
# neither half can work in this guest: the confining executors need bwrap or
# Landlock (the guest kernel has neither, and an unusable runner fails closed
# with SANDBOX_UNAVAILABLE rather than running unconfined), and approval is
# answered only by a UI channel or the ACP bridge, so `ask` fails closed to
# `unavailable` with no one to ask. `danger-full-access` resolves the sandbox
# mode and, in the same expression, the approval policy to `never`.
: "${DSH_PERMISSION_MODE:=danger-full-access}"
export DSH_PERMISSION_MODE

# Never exit over setup trouble: the terminal starts a fresh session the moment
# this one ends, so an exit here would respawn in a loop.
mkdir -p "$WORKSPACE" 2>/dev/null || true
cd "$WORKSPACE" 2>/dev/null || cd / || true

BOLD=$(printf '\033[1m')
DIM=$(printf '\033[2m')
CYAN=$(printf '\033[1;36m')
GREEN=$(printf '\033[1;32m')
RESET=$(printf '\033[0m')

context=on
version=$(sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$DSH_PKG/package.json" 2>/dev/null | head -n 1)

usage() {
	printf '%s\n' \
		"  ${BOLD}<文字>${RESET}     交给 dsh 执行（会带上本次对话的历史）" \
		"  ${BOLD}!<命令>${RESET}    执行一条 shell 命令，不进模型" \
		"  ${BOLD}!sh${RESET}        进入 shell（exit 回这里）" \
		"  ${BOLD}/new${RESET}       清空历史，重新开始" \
		"  ${BOLD}/context${RESET}   开/关历史携带（当前：$context）" \
		"  ${BOLD}/help${RESET}      显示这段说明" \
		"  ${BOLD}exit${RESET}       退出（Ctrl-D 也行；会自动重开）"
}

trim() {
	# Keep the transcript bounded: a conversation that grows without limit
	# would be re-sent in full on every turn.
	if [ -s "$TRANSCRIPT" ] && [ "$(wc -c < "$TRANSCRIPT" | tr -d ' ')" -gt "$MAX_TRANSCRIPT" ]; then
		tail -c "$MAX_TRANSCRIPT" "$TRANSCRIPT" > "$TRANSCRIPT.tmp" 2>/dev/null &&
			mv "$TRANSCRIPT.tmp" "$TRANSCRIPT"
	fi
}

printf '%s\n' \
	"${GREEN}  dsh CLI${RESET}  ${DIM}官方 @deepseek-ai/dsh ${version}${RESET}" \
	"${DIM}  形态：dsh --profile headless（官方一发式，每次一条任务）${RESET}" \
	"${DIM}  上下文：由本脚本携带（已发布版本没有 --resume）${RESET}" \
	"${DIM}  工作目录 ${WORKSPACE}   模型出口 ${DEEPSEEK_BASE_URL}${RESET}" \
	""
usage
printf '\n'

while :; do
	printf '%s' "$CYAN"
	printf 'dsh> '
	printf '%s' "$RESET"
	IFS= read -r line || break

	line=$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
	[ -n "$line" ] || continue

	case "$line" in
	exit | quit | :q)
		break
		;;
	/help)
		usage
		continue
		;;
	/new)
		: > "$TRANSCRIPT"
		printf '%s  （历史已清空）%s\n' "$DIM" "$RESET"
		continue
		;;
	/context)
		if [ "$context" = on ]; then context=off; else context=on; fi
		printf '%s  （历史携带：%s）%s\n' "$DIM" "$context" "$RESET"
		continue
		;;
	'!'*)
		# A bare `!sh` hands the terminal over to a real shell; leaving that
		# shell ends the session, and the terminal starts a new one here.
		case "${line#!}" in
		sh | bash | ash | login)
			exec "${line#!}"
			;;
		esac
		sh -c "${line#!}"
		continue
		;;
	esac

	if [ "$context" = on ] && [ -s "$TRANSCRIPT" ]; then
		task="这是本次对话到目前为止的记录，请接着最后一条继续回答，不要复述历史。

$(cat "$TRANSCRIPT")
User: $line"
	else
		task="$line"
	fi

	# stdout is the answer, stderr is the reasoning stream; only stdout is
	# captured, so reasoning still reaches the terminal live.
	answer=$(node --expose-internals "$DSH_BIN" --profile headless "$task")
	status=$?
	[ -n "$answer" ] && printf '%s\n' "$answer"

	if [ "$status" -eq 0 ] && [ "$context" = on ]; then
		{
			printf 'User: %s\n' "$line"
			[ -n "$answer" ] && printf 'Assistant: %s\n' "$answer"
		} >> "$TRANSCRIPT"
		trim
	fi
	printf '\n'
done

printf '%s  dsh CLI 结束%s\n' "$DIM" "$RESET"
