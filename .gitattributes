# Shell scripts and dotenv files run inside the Alpine guest, where a stray
# carriage return becomes part of the last token on the line and silently
# breaks a comparison or a variable value. Pin them to LF regardless of the
# checking-out machine's core.autocrlf.
*.sh text eol=lf
.env text eol=lf

# The guest-side launchers have no extension, so *.sh does not cover them. These
# are the files the app execs: a CRLF here turns the shebang into
# "#!/bin/sh\r" and the whole app stops booting. Same rule, named explicitly.
/rootfs/overlay/usr/local/bin/* text eol=lf
/rootfs/overlay/usr/local/share/dsh/*.yml text eol=lf

# Hooks are shell scripts too: a CRLF shebang makes sh refuse to run them.
/hooks/* eol=lf
/scripts/*.sh eol=lf
